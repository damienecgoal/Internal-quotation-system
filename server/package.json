{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test src/calc.test.ts src/excel.test.ts src/api.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create quotation",
    "d1:migrate": "wrangler d1 migrations apply quotation --remote"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.5",
    "exceljs": "^4.4.0",
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.42.0"
  }
}
